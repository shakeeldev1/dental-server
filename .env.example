# =============================================================================
# Expert Dental Center CRM — Backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins for CORS
# e.g. http://localhost:5173,https://crm.expertdental.example
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (server-side, service role — keep secret) ----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify the Supabase Auth JWT sent by the frontend
SUPABASE_JWT_SECRET=

# --- WhatsApp provider (custom2.waghl.com, QR-session API) -------------------
# Base URL (no trailing slash). Endpoints: /send-message, /send-media, /send-document
WHATSAPP_API_URL=https://custom2.waghl.com
# From admin panel: add a user → info (eye) icon
WHATSAPP_API_KEY=
# Device token from "view devices" (the sending number)
WHATSAPP_SENDER=
# Optional shared secret; if set, the webhook requires ?secret=<value>
WHATSAPP_WEBHOOK_SECRET=

# --- Clinic defaults (can also be managed in DB settings) --------------------
CLINIC_NAME=Expert Dental Center
GOOGLE_REVIEW_URL=
